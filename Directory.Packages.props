<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Every shipped dependency is recorded here with its licence, per AGENTS.md and
       Apache-2.0 4d. This list is the inventory the composition scan and the SBOM read. -->
  <ItemGroup Label="Shipped in the artifact">
    <!-- Avalonia: MIT -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <!-- CommunityToolkit.Mvvm: MIT, source-generator based (0002) -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Transitive pins. Not referenced directly by any project: these lift a dependency
       that something above brings in at a vulnerable version, which XE-081 forbids
       shipping. Central transitive pinning is what makes a PackageVersion alone
       sufficient. Remove a pin only once the parent package has moved past it.

       There are none at present. Tmds.DBus.Protocol was pinned to 0.21.3 while Avalonia
       was on 11.3.0, whose Avalonia.FreeDesktop depended on 0.21.2 and so carried
       GHSA-xrw6-gwf8-vvr9 (High). Avalonia 12.1.2's Avalonia.FreeDesktop depends on
       [0.94.1, ), which is outside both of the advisory's affected ranges — (,0.21.3)
       and [0.22.0,0.92.0) — so the parent has moved past it and the pin is removed
       rather than carried forward. Carrying it forward would have been worse than
       redundant: 0.21.3 is below Avalonia's floor, so the pin would have forced a
       downgrade NuGet rejects. See 0006. -->

  <ItemGroup Label="Build and test only — never reaches the artifact">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
