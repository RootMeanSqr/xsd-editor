<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>xsd-editor</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- XE-074: a self-contained installable per platform, with the runtime embedded and
       nothing fetched by the end user. 0002 chose the JIT over NativeAOT. -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- XE-075: no outbound requests. Nothing here may add a telemetry or update path. -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>

    <!-- ILLinkTreatWarningsAsErrors defaults to TreatWarningsAsErrors, so the repository
         setting reaches the trimmer and a third party's trim-annotation coverage fails our
         publish. 0004 records trim warnings as reported rather than gating until they have
         been measured; this is what makes that true of the build as well as the document.

         Demoting one code at a time does not work: IL2104 (Avalonia.DesignerSupport) was
         suppressed first, and IL2026 then appeared from built-in COM support on Windows
         only. The family has to be taken as a whole or it is whack-a-mole.

         Our own code keeps its compile-time guard: XsdEditor.Core sets IsAotCompatible, so
         its trim and AOT analyser findings are ordinary compiler warnings and remain
         errors. Tightening this back is the Phase 2 item 0004 names. -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../XsdEditor.Core/XsdEditor.Core.csproj" />
  </ItemGroup>

</Project>
