<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>xsd-editor</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- XE-074: a self-contained installable per platform, with the runtime embedded and
       nothing fetched by the end user. 0002 chose the JIT over NativeAOT. -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- XE-075: no outbound requests. Nothing here may add a telemetry or update path. -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>

    <!-- IL2104 is the trimmer's per-assembly rollup, "assembly X produced trim warnings".
         Avalonia.DesignerSupport raises it, and TreatWarningsAsErrors would otherwise make
         a third party's trim-annotation coverage fail our publish. 0004 records trim
         warnings as reported rather than gating until they have been measured, so they are
         demoted here to match — without this the build contradicted that record.

         This demotes the rollup for OUR assemblies too, which is the cost. Our own code is
         still guarded at compile time: XsdEditor.Core sets IsAotCompatible, so its trim and
         AOT analyser findings are ordinary warnings and remain errors. Tightening this back
         to an error is the Phase 2 item 0004 names, once the real warning set is known. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../XsdEditor.Core/XsdEditor.Core.csproj" />
  </ItemGroup>

</Project>
